    "catalog": [
      {
        "id": "E_SELF_MADE",
        "name": "白手起家",
        "when": "origin==humble AND NW>=P70_of_cohort AND no_inheritance_flag"
      },
      {
        "id": "E_ERA_RIDER",
        "name": "时代弄潮儿",
        "when": "at_least_two_matched_era_bets_succeeded AND wind_capture_rate>=0.5"
      },
      {
        "id": "E_COMPOUND",
        "name": "稳健复利家",
        "when": "annualized_real_return in [0.04,0.10] AND max_drawdown<=0.25 AND never_bankrupt"
      },
      {
        "id": "E_COMEBACK",
        "name": "逆风翻盘",
        "when": "had_crisis AND recovered AND final_NW>=pre_crisis_NW"
      },
      {
        "id": "E_FREE_LIFE",
        "name": "自由生活家",
        "when": "passive_income>=living_cost*1.2 for last 5 years AND lifestyle!=overwork"
      },
      {
        "id": "E_CAREER_PEAK",
        "name": "职场登峰者",
        "when": "path in {public,employee,professional} AND level==principal AND tenure>=8"
      },
      {
        "id": "E_FOUNDER",
        "name": "创业冒险家",
        "when": "founded AND (exit_success OR venture_value>=threshold) AND accepted_risk"
      },
      {
        "id": "E_STEWARD",
        "name": "资产守护者",
        "when": "max_drawdown<=0.15 AND never_missed_debt AND family>=60"
      },
      {
        "id": "E_HIGH_INCOME_TRAP",
        "name": "高收入困局",
        "when": "income_P80 AND liquid_runway_months<6 AND lifestyle==hedonic"
      },
      {
        "id": "E_PAPER_RICH",
        "name": "纸面富翁",
        "when": "NW>=P80 AND liquid_assets/NW<=0.15 AND housing+venture share high"
      },
      {
        "id": "E_MISSED_WINDOW",
        "name": "错过风口",
        "when": "at_least_two_major_windows_declined AND counterfactual_EV_gap>=threshold"
      },
      {
        "id": "E_ORDINARY_RICH",
        "name": "平凡而丰盛",
        "when": "balanced_growth high AND no_extreme_title AND family+health>=threshold"
      }
    ],
    "fallback_primary": "E_ORDINARY_RICH",
    "special_early": [
      {
        "id": "E_EARLY_HEALTH",
        "name": "因健康提前收束",
        "ends_life": true
      }
