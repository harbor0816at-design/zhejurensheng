  "cashflow": {
    "identity": "C(t+1) = C(t) + I - E - T - D + F",
    "net_worth_identity": "NW = A - L",
    "components": {
      "I": [
        "salary_net_before_tax",
        "business_owner_draw",
        "investment_distribution",
