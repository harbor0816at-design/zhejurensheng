        "social_insurance",
        "property_tax",
        "transaction_tax"
      ],
      "D": [
        "mortgage_interest",
        "mortgage_principal",
        "consumer_loan_interest",
        "consumer_loan_principal",
        "business_loan_personal_guarantee"
      ],
      "F": [
        "new_personal_loan",
        "new_mortgage",
        "business_financing_to_personal",
        "asset_sale_proceeds",
        "asset_purchase_outflow"
      ]
    },
    "ledger_required": true,
    "tolerance": 0.01,
    "comment": "每一笔对 C 的改动必须有 LedgerEntry。年结后用恒等式对账，误差超过 tolerance 视为引擎故障。asset_purchase_outflow 记入 F 的负项，不得直接改 C 而不入账。"
  },
